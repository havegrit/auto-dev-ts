# 환경 파일 경로
# 기본값은 .env다. 이 변수는 .env 내부가 아니라 셸이나 systemd에서 지정해야 한다.
# AUTO_DEV_ENV_FILE=./.env.local

# 기본 실행 설정
AUTO_DEV_WORKSPACE_ROOT=./data/workspace
AUTO_DEV_DB_PATH=./data/auto-dev.db
AUTO_DEV_CONFIG_PATH=./data/config.json
AUTO_DEV_BIND_ADDR=127.0.0.1
AUTO_DEV_BIND_PORT=8080
AUTO_DEV_DAILY_RUN_LIMIT=100
AUTO_DEV_CIRCUIT_BREAKER_FALLBACK_MS=300000

# 성공한 spec의 문서 점검·커밋 후처리에서 사용할 전역 skill 경로 override
# 기본 탐색 순서: ~/.codex/skills, ~/.claude/skills
# AUTO_DEV_SKILLS_ROOT=/home/your-user/.codex/skills

# 대시보드에서 저장한 모델 설정은 아래 환경 변수보다 우선한다.
# 프로바이더: anthropic | codex-cli | openai-compatible
# AUTO_DEV_PROVIDER=anthropic
# AUTO_DEV_MODEL=claude-sonnet-4-6
# AUTO_DEV_FALLBACK_MODEL=anthropic:claude-sonnet-4-6
# AUTO_DEV_EFFORT=high
# 에이전트별 모델을 지정할 때 필요한 항목만 설정한다.
# AUTO_DEV_AGENT_SCAFFOLD_MODEL=anthropic:claude-opus-4-8
# AUTO_DEV_AGENT_REVIEW_MODEL=anthropic:claude-sonnet-4-6

# Claude CLI
# 기본 명령은 claude다.
# AUTO_DEV_CLAUDE_COMMAND=claude

# Codex CLI
# 비워 두면 비-root 실행에서 저장소의 scripts/codex-wrapper.sh를 사용한다.
# AUTO_DEV_CODEX_COMMAND=/usr/local/bin/codex
# AUTO_DEV_CODEX_TIMEOUT_MS=600000
# 샌드박스 모드 예: workspace-write. 기본 CLI 설정을 사용하려면 설정하지 않는다.
# AUTO_DEV_CODEX_SANDBOX=workspace-write
# 승인 및 샌드박스 우회는 위험한 설정이다. 격리된 신뢰 환경에서만 사용한다.
# AUTO_DEV_CODEX_BYPASS_SANDBOX=1

# OpenAI 호환 텍스트 생성기 (에이전트 도구 실행에는 사용하지 않음)
# AUTO_DEV_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# 비밀 키를 입력하고 이 파일을 커밋하지 않는다.
# AUTO_DEV_OPENAI_API_KEY=
# AUTO_DEV_OPENAI_MODELS=deepseek-ai/deepseek-v4-pro
# AUTO_DEV_OPENAI_MAX_TOKENS=16384

# PR 전달 — 외부 HTTPS 프록시가 대시보드와 모든 API를 보호한 뒤에만 설정한다.
# 아래 값은 접근 제어를 구성하지 않고 보호 상태에 대한 운영자 확인만 표시한다.
# AUTO_DEV_PUBLIC_BASE_URL=https://autodev.example.com
# AUTO_DEV_PUBLIC_ACCESS_CONTROL=authenticated

# 자동 머지 요청의 서버 기능 상한. 프로젝트별 opt-in과 별도 저장소 allowlist도 필요하다.
AUTO_DEV_AUTO_MERGE_ENABLED=false
# 정확한 GitHub OWNER/REPO 목록만 허용한다. 와일드카드는 지원하지 않는다.
# AUTO_DEV_AUTO_MERGE_REPOSITORIES=org/repo

# Docker Compose
AUTO_DEV_HOST_PORT=8080
# 여러 clone을 동시에 실행할 때 프로젝트 이름도 분리한다.
# COMPOSE_PROJECT_NAME=auto-dev-local
# Docker 이미지 빌드 시 사용할 Claude Code CLI 버전 override
# CLAUDE_CODE_VERSION=2.1.274

# root에서 npm run serve:user 또는 scripts/serve.sh를 시작할 때 사용할 비-root 계정
AUTO_DEV_RUN_AS_USER=shin

# SQLite 백업
# AUTO_DEV_BACKUP_DIR=./data/backups

# 이슈 트래커 연동 (URL을 설정하면 활성화)
# AUTO_DEV_ISSUE_TRACKER_URL=http://127.0.0.1:8081
# AUTO_DEV_ISSUE_TRACKER_STATUS=OPEN

# 일일 워크로그 브리핑
# AUTO_DEV_WORKLOG_BRIEFING_ENABLED=false
# AUTO_DEV_WORKLOG_BRIEFING_CRON=0 9 * * *
# AUTO_DEV_WORKLOG_PATH=./data/worklog.md

# OpenClaw Telegram 알림 (OpenClaw가 수신하고 auto-dev가 완료/실패 알림을 전송)
# AUTO_DEV_OPENCLAW_ENABLED=false
# AUTO_DEV_OPENCLAW_ACCOUNT=main
# AUTO_DEV_OPENCLAW_COMMAND=openclaw
# AUTO_DEV_OPENCLAW_CONFIG_PATH=/home/your-user/.openclaw/openclaw.json
# AUTO_DEV_OPENCLAW_TARGET=<Telegram chat ID>
# 양쪽 프로세스에 같은 비밀 토큰을 지정할 때만 설정한다.
# AUTO_DEV_OPENCLAW_API_TOKEN=
