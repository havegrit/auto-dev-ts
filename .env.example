# 에이전트 파일 I/O 작업 디렉토리
AUTO_DEV_WORKSPACE_ROOT=./data/workspace

# SQLite DB 경로
AUTO_DEV_DB_PATH=./data/auto-dev.db

# HTTP 서버 바인드 (WSL2에서 Windows 브라우저 접근 시 0.0.0.0 사용)
AUTO_DEV_BIND_ADDR=127.0.0.1
AUTO_DEV_BIND_PORT=8080

# LLM 프로바이더 선택 (src/llm/registry.ts — 기본: anthropic)
# AUTO_DEV_PROVIDER=anthropic

# 사용할 프로바이더 모델
# AUTO_DEV_MODEL=claude-sonnet-4-6

# 에이전트별 모델 override (예: scaffold만 별도 모델 사용)
# AUTO_DEV_AGENT_SCAFFOLD_MODEL=claude-opus-4-8

# 선택 모델을 사용할 수 없을 때 쓸 폴백 모델
# AUTO_DEV_FALLBACK_MODEL=claude-sonnet-4-6

# 대시보드 설정 저장 파일 (환경 변수보다 우선 적용)
# AUTO_DEV_CONFIG_PATH=./data/config.json

# Codex CLI provider 사용 시
# AUTO_DEV_CODEX_COMMAND=codex
# AUTO_DEV_CODEX_TIMEOUT_MS=600000

# OpenAI 호환 provider (NVIDIA NIM / DeepSeek / OpenRouter / 로컬 vLLM 등)
# 텍스트 생성(completer)만 지원 — 도구 쓰는 에이전트 단계(scaffold 등)에는 사용 불가.
# 모델 선택 시 provider:model 형태로 지정 (예: openai-compatible:deepseek-ai/deepseek-v4-pro)
# API_KEY 미설정이면 모델 목록에서 자동 제외되어 기존 동작에 영향 없음.
# AUTO_DEV_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# AUTO_DEV_OPENAI_API_KEY=
# AUTO_DEV_OPENAI_MODELS=deepseek-ai/deepseek-v4-pro
# AUTO_DEV_OPENAI_MAX_TOKENS=16384

# Effort 레벨: low | medium | high | xhigh | max (기본: high)
# AUTO_DEV_EFFORT=high

# 일일 실행 횟수 제한 (런어웨이 방지)
AUTO_DEV_DAILY_RUN_LIMIT=100

# rate limit 감지 회로 차단기 — resetsAt 미제공 플랫폼의 fallback 쿨다운 (ms, 기본 5분)
# AUTO_DEV_CIRCUIT_BREAKER_FALLBACK_MS=300000

# issue-tracker 연동 (선택 — 설정 시 브리핑 + 자동 처리 활성화)
# AUTO_DEV_ISSUE_TRACKER_URL=http://127.0.0.1:8081
# AUTO_DEV_ISSUE_TRACKER_STATUS=OPEN

# 워크로그 브리핑 스케줄러
# AUTO_DEV_WORKLOG_BRIEFING_ENABLED=false
# AUTO_DEV_WORKLOG_BRIEFING_CRON=0 9 * * *
# AUTO_DEV_WORKLOG_PATH=./data/worklog.md

# OpenClaw Telegram 연동 (OpenClaw가 수신, auto-dev는 로컬 API 실행 + 완료 알림)
# AUTO_DEV_OPENCLAW_ENABLED=true
# AUTO_DEV_OPENCLAW_ACCOUNT=main
# AUTO_DEV_OPENCLAW_COMMAND=/home/user/.local/bin/openclaw
# AUTO_DEV_OPENCLAW_CONFIG_PATH=/home/user/.openclaw/openclaw.json
# AUTO_DEV_OPENCLAW_TARGET=123456789
# 로컬 프로세스 간 API에도 공유 토큰을 요구하려면 양쪽 환경에 같은 값 설정
# AUTO_DEV_OPENCLAW_API_TOKEN=
